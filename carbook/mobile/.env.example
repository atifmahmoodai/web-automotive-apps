# Public configuration, never client secrets. Configure a native OIDC application with PKCE.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_AUDIENCE=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Filled after eas init. Not a signing credential.
EAS_PROJECT_ID=
# Optional map/geocoder overrides (public, non-secret, bundled into the app).
# Raster tile template; must be https and contain {z}, {x} and {y}. Empty = OpenStreetMap standard tiles
# (fine for a pilot; use a commercial or self-hosted tile provider for production traffic per the OSM tile policy).
EXPO_PUBLIC_MAP_TILE_URL=
# Nominatim-compatible geocoder base URL used when organizers pin an event. Empty = nominatim.openstreetmap.org
# (max 1 request/second, no bulk use). Set to "off" to allow coordinates only.
EXPO_PUBLIC_GEOCODER_URL=
# Public Carbook website used for "Open website" links. Empty = the current hosted preview site.
EXPO_PUBLIC_WEB_URL=
# Optional, off when empty. HTTPS endpoints that accept a JSON POST. Reports are scrubbed of tokens,
# emails, phone-like numbers and URL secrets before sending, and capped per app session. Never put an API key here.
EXPO_PUBLIC_CRASH_REPORT_URL=
EXPO_PUBLIC_ANALYTICS_URL=
