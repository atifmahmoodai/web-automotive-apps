{
  "name": "carbook-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "export": "expo export --platform all",
    "test": "node scripts/check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "eas-build-pre-install": "node scripts/release-check.mjs",
    "api:build": "node scripts/build-api.mjs",
    "api:dev": "npm run api:build && wrangler dev --config service/wrangler.jsonc",
    "api:typecheck": "tsc --noEmit -p service/tsconfig.json",
    "api:deploy": "npm run api:build && wrangler deploy --config service/wrangler.jsonc"
  },
  "dependencies": {
    "expo": "~58.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.0",
    "wrangler": "^4.92.0"
  }
}
