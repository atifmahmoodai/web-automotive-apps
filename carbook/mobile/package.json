{
  "name": "carbook-mobile",
  "version": "0.3.1",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "export": "expo export --platform all",
    "test": "node scripts/check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "eas-build-pre-install": "node scripts/release-check.mjs",
    "api:build": "node scripts/build-api.mjs",
    "api:dev": "npm run api:build && wrangler dev --config service/wrangler.jsonc",
    "api:typecheck": "tsc --noEmit -p service/tsconfig.json",
    "api:deploy": "npm run api:build && wrangler deploy --config service/wrangler.jsonc"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.92.0"
  }
}
